{
  "name": "@libraz/formulon",
  "version": "0.12.0",
  "description": "Excel 365 calculation engine -- WASM binding",
  "license": "Apache-2.0",
  "author": "libraz",
  "type": "module",
  "main": "./dist/formulon.js",
  "types": "./dist/formulon.d.ts",
  "exports": {
    ".": {
      "types": "./dist/formulon.d.ts",
      "import": "./dist/formulon.js",
      "default": "./dist/formulon.js"
    },
    "./formulon.wasm": "./dist/formulon.wasm",
    "./threads": {
      "types": "./dist/formulon.d.ts",
      "import": "./dist/formulon_threads.js",
      "default": "./dist/formulon_threads.js"
    },
    "./formulon_threads.wasm": "./dist/formulon_threads.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "excel",
    "spreadsheet",
    "formula",
    "wasm",
    "xlsx",
    "calculation"
  ],
  "homepage": "https://formulon.libraz.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/formulon.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/formulon/issues"
  },
  "sideEffects": [
    "./dist/formulon_threads_core.js"
  ]
}
