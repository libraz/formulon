{
  "suite": "encodeurl",
  "description": "ENCODEURL -- RFC 3986 percent-encoding with uppercase hex (Excel 365 Mac ja-JP)",
  "environment": {
    "excel_version": "16.0",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-05-15T02:55:28Z"
  },
  "tolerance": {
    "abs": 0.0,
    "rel": 0.0
  },
  "cases": [
    {
      "id": "encodeurl_space",
      "formula": "=ENCODEURL(\"hello world\")",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "hello%20world"
      }
    },
    {
      "id": "encodeurl_query_string_chars",
      "formula": "=ENCODEURL(\"a/b c?d=1&e=2\")",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "a%2Fb%20c%3Fd%3D1%26e%3D2"
      }
    },
    {
      "id": "encodeurl_unreserved_passthrough",
      "formula": "=ENCODEURL(\"ABCabc012-_.~\")",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "ABCabc012-_.%7E"
      }
    },
    {
      "id": "encodeurl_japanese_utf8",
      "formula": "=ENCODEURL(\"日本語\")",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "%E6%97%A5%E6%9C%AC%E8%AA%9E"
      }
    },
    {
      "id": "encodeurl_bool_true",
      "formula": "=ENCODEURL(TRUE)",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "TRUE"
      }
    },
    {
      "id": "encodeurl_empty_string",
      "formula": "=ENCODEURL(\"\")",
      "setup": {},
      "expect": {
        "kind": "blank"
      },
      "compare_mode": "empty_string_readback"
    },
    {
      "id": "encodeurl_percent_self_encodes",
      "formula": "=ENCODEURL(\"100%\")",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "100%25"
      }
    }
  ]
}
