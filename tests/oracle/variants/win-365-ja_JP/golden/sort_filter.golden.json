{
  "suite": "sort_filter",
  "description": "Dynamic-array filter / dedupe / sort family — FILTER, UNIQUE, SORT, SORTBY (Excel 365). 24 perspectives (6 per function); spill outputs, scalar fallback, and scalar errors are captured live by the array-aware oracle harness.",
  "environment": {
    "excel_version": "16.0",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-08-15T18:52:11Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "filter_row_axis_basic",
      "formula": "=FILTER({1;2;3}, {TRUE;FALSE;TRUE})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          1.0,
          3.0
        ],
        "shape": [
          2,
          1
        ]
      }
    },
    {
      "id": "filter_col_axis_basic",
      "formula": "=FILTER({1,2,3}, {TRUE,FALSE,TRUE})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          1.0,
          3.0
        ],
        "shape": [
          1,
          2
        ]
      }
    },
    {
      "id": "filter_empty_with_if_empty",
      "formula": "=FILTER({1;2;3}, {FALSE;FALSE;FALSE}, \"none\")",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "none"
      }
    },
    {
      "id": "filter_empty_without_if_empty_calc",
      "formula": "=FILTER({1;2;3}, {FALSE;FALSE;FALSE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#CALC!"
      }
    },
    {
      "id": "filter_shape_mismatch_value",
      "formula": "=FILTER({1;2;3}, {TRUE;FALSE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "filter_include_error_propagates",
      "formula": "=FILTER({1;2;3}, {TRUE;#N/A;TRUE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#N/A"
      }
    },
    {
      "id": "unique_row_axis_dedup",
      "formula": "=UNIQUE({\"A\";\"B\";\"A\";\"C\"})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "A",
          "B",
          "C"
        ],
        "shape": [
          3,
          1
        ]
      }
    },
    {
      "id": "unique_col_axis_dedup",
      "formula": "=UNIQUE({1,2,1,3}, TRUE)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          1.0,
          2.0,
          3.0
        ],
        "shape": [
          1,
          3
        ]
      }
    },
    {
      "id": "unique_exactly_once_keeps_singletons",
      "formula": "=UNIQUE({1;2;1;3}, FALSE, TRUE)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          2.0,
          3.0
        ],
        "shape": [
          2,
          1
        ]
      }
    },
    {
      "id": "unique_exactly_once_empty_calc",
      "formula": "=UNIQUE({1;1;2;2}, FALSE, TRUE)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#CALC!"
      }
    },
    {
      "id": "unique_case_insensitive_text",
      "formula": "=UNIQUE({\"a\";\"A\";\"b\"})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "a",
          "b"
        ],
        "shape": [
          2,
          1
        ]
      }
    },
    {
      "id": "unique_pass_through_all_distinct",
      "formula": "=UNIQUE({\"X\";\"Y\";\"Z\"})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "X",
          "Y",
          "Z"
        ],
        "shape": [
          3,
          1
        ]
      }
    },
    {
      "id": "sort_row_ascending_default",
      "formula": "=SORT({3;1;2})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          1.0,
          2.0,
          3.0
        ],
        "shape": [
          3,
          1
        ]
      }
    },
    {
      "id": "sort_col_axis_by_col",
      "formula": "=SORT({3,1,2}, 1, 1, TRUE)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          1.0,
          2.0,
          3.0
        ],
        "shape": [
          1,
          3
        ]
      }
    },
    {
      "id": "sort_descending_order",
      "formula": "=SORT({1;2;3}, 1, -1)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          3.0,
          2.0,
          1.0
        ],
        "shape": [
          3,
          1
        ]
      }
    },
    {
      "id": "sort_index_out_of_range_value",
      "formula": "=SORT({1,2;3,4}, 5)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "sort_invalid_order_value",
      "formula": "=SORT({1;2;3}, 1, 99)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "sort_mixed_kind_ordering",
      "formula": "=SORT({TRUE;\"x\";1;#N/A})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          1.0,
          "x",
          true,
          {
            "kind": "error",
            "code": "#N/A"
          }
        ],
        "shape": [
          4,
          1
        ]
      }
    },
    {
      "id": "sortby_single_key_ascending",
      "formula": "=SORTBY({\"A\";\"B\";\"C\"}, {3;1;2})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "B",
          "C",
          "A"
        ],
        "shape": [
          3,
          1
        ]
      }
    },
    {
      "id": "sortby_single_key_descending",
      "formula": "=SORTBY({\"A\";\"B\";\"C\"}, {1;2;3}, -1)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "C",
          "B",
          "A"
        ],
        "shape": [
          3,
          1
        ]
      }
    },
    {
      "id": "sortby_two_key_composite",
      "formula": "=SORTBY({\"A\";\"B\";\"C\";\"D\"}, {1;1;2;2}, 1, {2;1;2;1}, 1)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "B",
          "A",
          "D",
          "C"
        ],
        "shape": [
          4,
          1
        ]
      }
    },
    {
      "id": "sortby_row_vector_sorts_cols",
      "formula": "=SORTBY({\"A\",\"B\",\"C\"}, {3,1,2})",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "B",
          "C",
          "A"
        ],
        "shape": [
          1,
          3
        ]
      }
    },
    {
      "id": "sortby_shape_mismatch_value",
      "formula": "=SORTBY({\"A\";\"B\";\"C\"}, {1;2})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "sortby_invalid_order_value",
      "formula": "=SORTBY({\"A\";\"B\"}, {1;2}, 99)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    }
  ]
}
