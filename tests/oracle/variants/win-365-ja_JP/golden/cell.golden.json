{
  "suite": "cell",
  "description": "CELL(info_type, [reference]) — info_type dispatch covering address/col/row/contents/type and the metadata stubs (filename/format/color/parentheses/prefix/protect/width).",
  "environment": {
    "excel_version": "16.0",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-05-14T23:44:10Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "cell_address_simple",
      "formula": "=CELL(\"address\", A1)",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "$A$1"
      }
    },
    {
      "id": "cell_address_other_cell",
      "formula": "=CELL(\"address\", B5)",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "$B$5"
      }
    },
    {
      "id": "cell_col_b5",
      "formula": "=CELL(\"col\", B5)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 2.0
      }
    },
    {
      "id": "cell_row_b5",
      "formula": "=CELL(\"row\", B5)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 5.0
      }
    },
    {
