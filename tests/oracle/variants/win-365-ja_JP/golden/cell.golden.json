      "formula": "=CELL(\"col\", C3:E5)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 3.0
      }
    },
    {
      "id": "cell_contents_number",
      "formula": "=CELL(\"contents\", A1)",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 42.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 42.0
      }
    },
    {
      "id": "cell_contents_text",
      "formula": "=CELL(\"contents\", A1)",
      "setup": {
        "A1": {
          "kind": "text",
          "value": "hello"
        }
      },
      "expect": {
        "kind": "text",
        "value": "hello"
      }
    },
    {
      "id": "cell_contents_blank_returns_zero",
      "formula": "=CELL(\"contents\", A1)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 0.0
      }
    },
    {
      "id": "cell_type_blank",
      "formula": "=CELL(\"type\", A1)",
      "setup": {},
      "expect": {
        "kind": "text",
        "value": "b"
      }
    },
    {
      "id": "cell_type_number",
      "formula": "=CELL(\"type\", A1)",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 3.14
        }
      },
      "expect": {
        "kind": "text",
        "value": "v"
      }
    },
    {
      "id": "cell_type_text",
      "formula": "=CELL(\"type\", A1)",
      "setup": {
        "A1": {
          "kind": "text",
          "value": "hello"
        }
      },
      "expect": {
        "kind": "text",
        "value": "l"
      }
    },
    {
      "id": "cell_type_empty_string",
      "formula": "=CELL(\"type\", A1)",
      "setup": {
        "A1": {
          "kind": "text",
          "value": ""
        }
      },
      "expect": {
        "kind": "text",
        "value": "b"
      }
    },
    {
      "id": "cell_format_general",
      "formula": "=CELL(\"format\", A1)",
