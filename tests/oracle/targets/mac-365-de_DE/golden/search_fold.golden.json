{
  "suite": "search_fold",
  "description": "SEARCH / SEARCHB character equivalence beyond ASCII. Each character is compared under the locale's `=` collation one code point at a time: case, and where the locale folds them width and kana, match; expansions (ß/ss), half-width voicing composition and accents do not. The `=` cases show the whole-string contrast.",
  "environment": {
    "excel_version": "16.113.4",
    "excel_locale": "de-DE",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-10-11T16:11:01Z"
