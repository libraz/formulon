{
  "suite": "locale_tokens",
  "description": "Locale-dependent spellings Excel accepts or produces: date format tokens across every month and weekday, General and colour keywords, AM/PM designators, currency text parsing, error names in text output, and formula text separators. Each case is captured under every target, so a token another locale ignores still records what it does here.\n",
  "environment": {
    "excel_version": "16.113.3",
    "excel_locale": "de-DE",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-10-08T19:50:46Z"
  },
