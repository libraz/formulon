{
  "suite": "entry_canonical",
  "description": "How Excel re-spells a formula on entry. Setup writes the formula into B1 exactly as typed (lower or mixed case, odd spacing, unnormalised numbers); the probe reads the stored spelling back through FORMULATEXT. Function names, references, sheet qualifiers, error literals and booleans are upper-cased or re-spelled; string literals, LET/LAMBDA parameter spellings (first occurrence wins), unknown function names (folded to lower case) and most whitespace are kept; number literals are re-rendered.\n",
  "environment": {
    "excel_version": "16.114.4",
    "excel_locale": "de-DE",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-11-10T01:06:44Z"
  },
  "tolerance": {
    "abs": 0.0,
    "rel": 0.0
  },
  "cases": [
    {
      "id": "fn_lower",
      "formula": "=FORMULATEXT(B1)",
      "setup": {
        "B1": {
          "kind": "formula",
          "formula": "=sum(1,2)"
        }
      },
      "expect": {
        "kind": "text",
        "value": "=SUMME(1;2)"
      }
    },
    {
      "id": "fn_mixed",
      "formula": "=FORMULATEXT(B1)",
      "setup": {
        "B1": {
          "kind": "formula",
          "formula": "=Sum(1,2)"
        }
      },
      "expect": {
        "kind": "text",
        "value": "=SUMME(1;2)"
      }
    },
