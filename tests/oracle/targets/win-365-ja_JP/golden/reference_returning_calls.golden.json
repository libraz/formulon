{
  "suite": "reference_returning_calls",
  "description": "IFS and SWITCH return the reference their chosen branch names, not its value: ISREF sees a reference, the result can end a `:` range, and CELL reads its address. A1:A3 = 1,2,3 and A5 = 5 throughout.\n",
  "environment": {
    "excel_version": "16.0.20228",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-09-30T05:45:37Z"
  },
  "tolerance": {
    "abs": 0.0,
    "rel": 0.0
  },
  "cases": [
    {
      "id": "isref_ifs_branch",
      "formula": "=ISREF(IFS(TRUE,A1))",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 1.0
        },
        "A2": {
          "kind": "number",
          "value": 2.0
        },
        "A3": {
          "kind": "number",
          "value": 3.0
        },
        "A5": {
          "kind": "number",
          "value": 5.0
        }
      },
      "expect": {
        "kind": "bool",
        "value": true
      }
    },
    {
      "id": "isref_switch_branch",
      "formula": "=ISREF(SWITCH(1,1,A1))",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 1.0
        },
        "A2": {
          "kind": "number",
          "value": 2.0
        },
        "A3": {
          "kind": "number",
          "value": 3.0
        },
        "A5": {
          "kind": "number",
          "value": 5.0
        }
      },
      "expect": {
        "kind": "bool",
        "value": true
      }
    },
    {
      "id": "sum_range_ending_in_ifs",
      "formula": "=SUM(A1:IFS(TRUE,A3))",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 1.0
        },
        "A2": {
          "kind": "number",
          "value": 2.0
        },
        "A3": {
          "kind": "number",
          "value": 3.0
        },
        "A5": {
          "kind": "number",
          "value": 5.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 6.0
      }
    },
    {
      "id": "sum_range_ending_in_switch",
      "formula": "=SUM(A1:SWITCH(1,1,A3))",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 1.0
        },
        "A2": {
          "kind": "number",
          "value": 2.0
        },
        "A3": {
          "kind": "number",
          "value": 3.0
        },
        "A5": {
          "kind": "number",
          "value": 5.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 6.0
      }
    },
    {
      "id": "rows_range_ending_in_switch",
      "formula": "=ROWS(A1:SWITCH(1,1,A5))",
      "setup": {
        "A1": {
          "kind": "number",
          "value": 1.0
        },
        "A2": {
          "kind": "number",
          "value": 2.0
        },
        "A3": {
          "kind": "number",
          "value": 3.0
        },
