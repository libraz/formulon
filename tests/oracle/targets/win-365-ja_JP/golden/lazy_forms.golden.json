{
  "suite": "lazy_forms",
  "description": "Representative probes for real lazy forms that are not unavailable stubs. Full workbook-backed coverage lives in unit/integration tests; this suite keeps the oracle catalog from treating their existence as part of the external-stub bucket.",
  "environment": {
    "excel_version": "16.0.20326",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-09-30T07:12:27Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "lazy_getpivotdata_no_pivot",
      "formula": "=GETPIVOTDATA(\"amount\", A1)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#REF!"
      }
    },
    {
      "id": "lazy_phonetic_literal_text",
      "formula": "=PHONETIC(\"テスト\")",
      "setup": {},
      "skipped": "driver skip: COM -2147352567: 例外が発生しました。 -- scode=0x800A03EC"
    },
    {
      "id": "lazy_phonetic_unannotated_cell",
      "formula": "=PHONETIC(A1)",
      "setup": {
        "A1": {
          "kind": "text",
          "value": "テスト"
        }
      },
      "expect": {
        "kind": "text",
        "value": "テスト"
      }
    }
  ]
}
