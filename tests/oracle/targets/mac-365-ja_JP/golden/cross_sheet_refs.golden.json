{
  "suite": "cross_sheet_refs",
  "description": "Cross-sheet and 3-D references. The case formula sits at Sheet1!Z1 (the oracle driver convention) and reaches into other sheets via direct Sheet2!A1 references, INDIRECT(\"Sheet2!A1\") runtime resolution, and Excel's 3-D-range syntax (Sheet1:Sheet3!A1). Setup keys carry the Sheet!Addr form; the driver creates the referenced sheet inside the per-case workbook on first use, and the C++ verifier mirrors that inside a single Workbook by adding sheets via add_sheet on first occurrence.\n",
  "environment": {
    "excel_version": "16.114.1",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-11-04T13:32:47Z"
  },
  "tolerance": {
    "abs": 0.0,
    "rel": 0.0
  },
  "cases": [
    {
      "id": "direct_sheet2_a1",
      "formula": "=Sheet2!A1",
      "setup": {
        "Sheet2!A1": {
          "kind": "number",
          "value": 42.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 42.0
      }
    },
    {
      "id": "sum_across_two_sheets",
      "formula": "=SUM(Sheet2!A1, Sheet3!A1)",
      "setup": {
        "Sheet2!A1": {
          "kind": "number",
          "value": 10.0
        },
        "Sheet3!A1": {
          "kind": "number",
          "value": 20.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 30.0
      }
    },
    {
      "id": "indirect_cross_sheet",
      "formula": "=INDIRECT(\"Sheet2!A1\")",
      "setup": {
        "Sheet2!A1": {
          "kind": "number",
          "value": 7.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 7.0
      }
    },
    {
      "id": "indirect_unquoted_non_ascii_sheet",
      "formula": "=INDIRECT(\"売上!A1\")",
      "setup": {
        "売上!A1": {
          "kind": "number",
          "value": 11.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 11.0
      }
    },
    {
      "id": "indirect_unquoted_dotted_sheet",
      "formula": "=INDIRECT(\"Sheet.1!A1\")",
      "setup": {
        "Sheet.1!A1": {
          "kind": "number",
          "value": 13.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 13.0
      }
    },
    {
      "id": "three_d_sum_two_sheet_span",
      "formula": "=SUM(Sheet2:Sheet3!A1)",
      "setup": {
        "Sheet2!A1": {
          "kind": "number",
          "value": 3.0
        },
        "Sheet3!A1": {
          "kind": "number",
          "value": 4.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 7.0
      }
    },
    {
      "id": "quoted_sheet_name_with_space",
      "formula": "='My Sheet'!A1",
      "setup": {
        "'My Sheet'!A1": {
          "kind": "number",
          "value": 99.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 99.0
      }
    },
    {
      "id": "missing_sheet_is_ref_error",
      "formula": "=Sheet9!A1",
      "setup": {
        "Sheet2!A1": {
          "kind": "number",
          "value": 0.0
        }
      },
      "expect": {
        "kind": "error",
        "code": "#REF!"
      }
    },
    {
      "id": "three_d_max",
      "formula": "=MAX(Sheet2:Sheet3!A1)",
      "setup": {
        "Sheet2!A1": {
          "kind": "number",
          "value": 5.0
        },
        "Sheet3!A1": {
          "kind": "number",
          "value": 12.0
        }
      },
      "expect": {
        "kind": "number",
        "value": 12.0
      }
    },
    {
      "id": "three_d_sum_spilled_whole_column",
      "formula": "=SUM(Sheet1:Sheet3!B:B)",
      "setup": {
        "Sheet1!A1": {
          "kind": "formula",
          "formula": "=SEQUENCE(3,2,1)"
        },
        "Sheet2!A1": {
          "kind": "formula",
          "formula": "=SEQUENCE(3,2,7)"
        },
        "Sheet3!A1": {
          "kind": "formula",
          "formula": "=SEQUENCE(3,2,13)"
        }
      },
      "expect": {
        "kind": "number",
        "value": 90.0
      }
    }
  ]
}
