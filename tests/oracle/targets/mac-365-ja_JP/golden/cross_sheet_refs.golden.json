{
  "suite": "cross_sheet_refs",
  "description": "Cross-sheet and 3-D references. The case formula sits at Sheet1!Z1 (the oracle driver convention) and reaches into other sheets via direct Sheet2!A1 references, INDIRECT(\"Sheet2!A1\") runtime resolution, and Excel's 3-D-range syntax (Sheet1:Sheet3!A1). Setup keys carry the Sheet!Addr form; the driver creates the referenced sheet inside the per-case workbook on first use, and the C++ verifier mirrors that inside a single Workbook by adding sheets via add_sheet on first occurrence.\n",
  "environment": {
    "excel_version": "16.114.4",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-11-07T19:53:32Z"
  },
  "tolerance": {
    "abs": 0.0,
