{
  "suite": "sheet_name_quoting",
  "description": "ADDRESS quotes sheet_text by the A1 sheet-qualifier rule of formula display, in both reference styles",
  "environment": {
    "excel_version": "16.113.4",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-10-15T02:50:56Z"
  },
  "tolerance": {
    "abs": 0.0,
