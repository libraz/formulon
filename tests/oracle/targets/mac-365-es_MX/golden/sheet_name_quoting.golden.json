{
  "suite": "sheet_name_quoting",
  "description": "ADDRESS quotes sheet_text by the A1 sheet-qualifier rule of formula display, in both reference styles; CELL(\"address\") quotes its sheet by the cross-workbook rule (the book name is stripped so the case reads the same in every workbook)",
  "environment": {
    "excel_version": "16.114.1",
    "excel_locale": "es-MX",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-10-25T17:33:25Z"
  },
