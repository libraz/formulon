{
  "suite": "power_fractional",
  "description": "Last-bit behaviour of ^ and POWER for a positive base: a fractional exponent goes through exp(log(x)*y) rather than a correctly rounded pow, 0.5 is a square root, a negative exponent is the reciprocal of the positive power, and an integer exponent is square-and-multiply. Values far from 1 are scaled so the readback keeps every digit.\n",
  "environment": {
    "excel_version": "16.114.1",
    "excel_locale": "nl-NL",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-10-25T11:19:37Z"
  },
  "tolerance": {
    "abs": 0.0,
    "rel": 0.0
  },
  "cases": [
