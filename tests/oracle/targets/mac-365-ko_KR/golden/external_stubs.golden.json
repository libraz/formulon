{
  "suite": "external_stubs",
  "description": "Unavailable host-service / connection stubs. These functions are recognized by name and arity, but Formulon deliberately returns a deterministic unavailable surface because the required service, network client, runtime, or OLAP connection is outside the pure calculation engine. Real implementations (ARRAYTOTEXT/FILTERXML), environment-bound functions (INFO/CELL), and real lazy forms (GETPIVOTDATA/PHONETIC) are intentionally not part of this suite.",
  "environment": {
    "excel_version": "16.113.4",
    "excel_locale": "ko-KR",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-10-17T20:31:03Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "external_stub_image",
      "formula": "=IMAGE(\"https://example.com/img.png\")",
      "setup": {},
      "skipped": "IMAGE fetches a network image; Formulon does no network I/O and stubs to #VALUE!. Oracle parity requires an embedded image client."
    },
    {
      "id": "external_stub_py",
      "formula": "=PY(\"import math\")",
      "setup": {},
      "skipped": "PY runs Python in the cloud; Formulon does not embed a Python runtime and stubs to #NAME?. Oracle parity requires the Microsoft 365 PY service."
    },
    {
      "id": "external_stub_rtd",
      "formula": "=RTD(\"server\", \"topic\", \"p1\")",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#N/A"
      }
    },
    {
      "id": "external_stub_stockhistory",
      "formula": "=STOCKHISTORY(\"MSFT\", DATE(2024,1,1))",
      "setup": {},
      "skipped": "STOCKHISTORY pulls live market data; Formulon does no network I/O. Oracle parity requires Microsoft 365 stock data subscription."
    },
    {
      "id": "external_stub_webservice",
      "formula": "=WEBSERVICE(\"https://example.com\")",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NAME?"
      }
    },
    {
      "id": "external_stub_copilot",
      "formula": "=COPILOT(\"hello\")",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NAME?"
      }
    },
    {
      "id": "external_stub_detectlanguage",
      "formula": "=DETECTLANGUAGE(\"hello world\")",
      "setup": {},
      "skipped": "DETECTLANGUAGE calls a translation cloud; Formulon does no network I/O and stubs to #NAME?."
    },
    {
      "id": "external_stub_translate",
      "formula": "=TRANSLATE(\"hello\", \"en\", \"ja\")",
      "setup": {},
      "skipped": "TRANSLATE calls a translation cloud; Formulon does no network I/O and stubs to #NAME?."
    },
    {
      "id": "external_stub_cubekpimember",
      "formula": "=CUBEKPIMEMBER(\"conn\", \"kpi\", 1)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#N/A"
      }
    },
