{
  "suite": "iterative_calc",
  "description": "Iterative-calc convergence. With Excel's \"Enable iterative calculation\" toggle ON (`Application.Iteration = True` on COM, `enable_iterative_calculation` on appscript), circular formulas converge to a fixed point instead of raising #CIRC!. The driver flips that flag for this suite via `options.iterative`; Excel defaults are MaxIterations=100, MaxChange=0.001, which give exact integer fixed points for monotonic clamp formulas and ~3 decimal digits of agreement for slow linear convergence (the smoothing case stops at MaxChange before reaching the theoretical fixed point of 10).\n",
  "environment": {
    "excel_version": "16.112",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": true,
    "generated_at": "2026-08-13T01:17:18Z"
  },
  "tolerance": {
    "abs": 0.001,
    "rel": 0.001
  },
  "cases": [
    {
      "id": "iter_clamp_counter_to_5",
      "formula": "=IF(Z1>=5, 5, Z1+1)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 5.0
      },
      "tolerance": {
        "abs": 0.0,
        "rel": 0.0
      }
    },
    {
      "id": "iter_halving_fixed_point",
      "formula": "=Z1/2 + 1",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 2.0
      }
    },
    {
      "id": "iter_smoothing_fixed_point",
      "formula": "=Z1*0.9 + 1",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 9.999444667132748
      }
    },
    {
      "id": "iter_two_cell_clamp_via_setup",
      "formula": "=A1",
      "setup": {
        "A1": {
          "kind": "formula",
          "formula": "=IF(A1>=10, 10, A1+1)"
        }
      },
      "expect": {
        "kind": "number",
        "value": 10.0
      },
      "tolerance": {
        "abs": 0.0,
        "rel": 0.0
      }
    },
    {
      "id": "iter_min_clamp_to_7",
      "formula": "=MIN(Z1+1, 7)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 7.0
      },
      "tolerance": {
        "abs": 0.0,
        "rel": 0.0
      }
    },
    {
      "id": "iter_constant_passthrough",
      "formula": "=42",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 42.0
      },
      "tolerance": {
        "abs": 0.0,
        "rel": 0.0
      }
    }
  ]
}
