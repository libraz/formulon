{
  "suite": "stat_legacy",
  "description": "Pre-2010 stat aliases (PERCENTILE / QUARTILE / STDEV / VAR) — alias dispatch verified on parallel perspectives. Result-equivalent to the .INC / .S forms covered by stats.yaml.",
  "environment": {
    "excel_version": "16.112",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-08-13T00:16:13Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "percentile_legacy_alias_median",
      "formula": "=PERCENTILE({1;2;3;4;5}, 0.5)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 3.0
      }
    },
    {
      "id": "percentile_legacy_alias_zero_k",
      "formula": "=PERCENTILE({10;20;30}, 0)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 10.0
      }
    },
    {
      "id": "percentile_legacy_alias_one_k",
      "formula": "=PERCENTILE({10;20;30}, 1)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 30.0
      }
    },
    {
      "id": "percentile_legacy_alias_interp",
      "formula": "=PERCENTILE({1;2;3;4}, 0.25)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.75
      }
    },
    {
      "id": "percentile_legacy_alias_out_of_range",
      "formula": "=PERCENTILE({1;2;3}, 1.5)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NUM!"
      }
    },
    {
      "id": "quartile_legacy_alias_q0_min",
      "formula": "=QUARTILE({1;2;3;4;5}, 0)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.0
      }
    },
    {
      "id": "quartile_legacy_alias_q2_median",
      "formula": "=QUARTILE({1;2;3;4;5}, 2)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 3.0
      }
    },
    {
      "id": "quartile_legacy_alias_q3",
      "formula": "=QUARTILE({1;2;3;4;5;6;7;8;9}, 3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 7.0
      }
    },
    {
      "id": "quartile_legacy_alias_q4_max",
      "formula": "=QUARTILE({1;2;3;4;5}, 4)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 5.0
      }
    },
    {
      "id": "quartile_legacy_alias_invalid",
      "formula": "=QUARTILE({1;2;3}, 5)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NUM!"
      }
    },
    {
      "id": "stdev_legacy_alias_basic",
      "formula": "=STDEV(1,2,3,4,5)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.5811388300841898
      }
    },
    {
      "id": "stdev_legacy_alias_array",
      "formula": "=STDEV({2;4;4;4;5;5;7;9})",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 2.138089935299395
      }
    },
    {
      "id": "stdev_legacy_alias_two_values",
      "formula": "=STDEV(1, 3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.4142135623730951
      }
    },
    {
      "id": "stdev_legacy_alias_negative",
      "formula": "=STDEV(-1,-2,-3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.0
      }
    },
    {
      "id": "stdev_legacy_alias_singleton_div0",
      "formula": "=STDEV(5)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#DIV/0!"
      }
    },
    {
      "id": "var_legacy_alias_basic",
      "formula": "=VAR(1,2,3,4,5)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 2.5
      }
    },
    {
      "id": "var_legacy_alias_array",
      "formula": "=VAR({2;4;4;4;5;5;7;9})",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 4.571428571428571
      }
    },
    {
      "id": "var_legacy_alias_two_values",
      "formula": "=VAR(1, 3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 2.0
      }
    },
    {
      "id": "var_legacy_alias_negative",
      "formula": "=VAR(-1,-2,-3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.0
      }
    },
    {
      "id": "var_legacy_alias_singleton_div0",
      "formula": "=VAR(5)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#DIV/0!"
      }
    }
  ]
}
