  "cases": [
    {
      "id": "pivotby_bare_sum",
      "formula": "=PIVOTBY({\"A\";\"B\"}, {\"X\";\"Y\"}, {1;2}, SUM, 0, 0, 0, 0, 0)",
      "setup": {},
      "skipped": "Mac Excel 16.109 returns #VALUE! for this compact inline-array PIVOTBY/SUM formula; Formulon returns the documented pivot spill. Unit test PivotBy.BareSumName covers bare-name aggregator dispatch."
    },
    {
      "id": "pivotby_lambda_sum",
      "formula": "=PIVOTBY({\"A\";\"B\"}, {\"X\";\"Y\"}, {1;2}, LAMBDA(v, SUM(v)), 0, 0, 0, 0, 0)",
      "setup": {},
      "skipped": "Mac Excel 16.109 returns #VALUE! for this compact inline-array PIVOTBY/LAMBDA formula; Formulon returns the documented pivot spill. Unit test PivotBy.BasicTwoByTwoLambdaAggregatorSum covers inline-LAMBDA dispatch."
