{
  "suite": "pivotby",
  "description": "PIVOTBY dynamic-array pivot (Excel 365). Perspectives parallel GROUPBY's structure — bare-name aggregator dispatch (spill), LAMBDA aggregator dispatch (spill), unknown-name ->",
  "environment": {
    "excel_version": "16.112",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-08-18T04:43:48Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "pivotby_bare_sum",
      "formula": "=PIVOTBY({\"A\";\"B\"}, {\"X\";\"Y\"}, {1;2}, SUM, 0, 0, , 0)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          null,
          "X",
          "Y",
          "A",
          1.0,
          null,
          "B",
          null,
          2.0
        ],
        "shape": [
          3,
          3
        ]
      }
    },
    {
      "id": "pivotby_lambda_sum",
      "formula": "=PIVOTBY({\"A\";\"B\"}, {\"X\";\"Y\"}, {1;2}, LAMBDA(v, SUM(v)), 0, 0, , 0)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          null,
          "X",
          "Y",
          "A",
          1.0,
          null,
          "B",
          null,
          2.0
        ],
        "shape": [
          3,
          3
        ]
      }
    },
    {
      "id": "pivotby_row_sort_order_zero_rejected",
      "formula": "=PIVOTBY({\"A\";\"B\"}, {\"X\";\"Y\"}, {1;2}, SUM, 0, 0, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "pivotby_unknown_name_error",
      "formula": "=PIVOTBY({\"A\";\"B\"}, {\"X\";\"Y\"}, {1;2}, NOPE_NAME, 0, 0, 0, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NAME?"
      }
    },
    {
      "id": "pivotby_field_headers_out_of_range",
