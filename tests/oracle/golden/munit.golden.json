{
  "suite": "munit",
  "description": "MUNIT(n) — n-by-n identity matrix; spill array reduced to scalar via INDEX / SUMPRODUCT for oracle capture.",
  "environment": {
    "excel_version": "16.108.1",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-04-28T10:05:53Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "munit_index_diagonal",
      "formula": "=INDEX(MUNIT(3), 2, 2)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.0
      }
    },
    {
      "id": "munit_index_off_diagonal",
      "formula": "=INDEX(MUNIT(3), 1, 3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 0.0
      }
    },
    {
      "id": "munit_size_one",
      "formula": "=INDEX(MUNIT(1), 1, 1)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.0
      }
    },
    {
      "id": "munit_fractional_truncates",
      "formula": "=INDEX(MUNIT(3.7), 3, 3)",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 1.0
      }
    },
    {
      "id": "munit_sumproduct_trace",
      "formula": "=SUMPRODUCT(MUNIT(4))",
      "setup": {},
      "expect": {
        "kind": "number",
        "value": 4.0
      }
    },
    {
      "id": "munit_zero_value_error",
      "formula": "=MUNIT(0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "munit_negative_value_error",
      "formula": "=MUNIT(-2)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "munit_text_value_error",
      "formula": "=MUNIT(\"hello\")",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    }
  ]
}
