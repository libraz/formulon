{
  "suite": "groupby",
  "description": "GROUPBY dynamic-array group-and-aggregate (Excel 365). Perspectives spanning bare-name aggregator dispatch (spill), LAMBDA aggregator dispatch (spill), unknown-name ->",
  "environment": {
    "excel_version": "16.112",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-08-14T19:34:32Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "groupby_bare_sum",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\"}, {10;20;30}, SUM, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "A",
          40.0,
          "B",
          20.0
        ],
        "shape": [
          2,
          2
        ]
      }
    },
    {
      "id": "groupby_lambda_sum",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\";\"C\"}, {10;20;30;40}, LAMBDA(v, SUM(v)), 0, 0)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "A",
          40.0,
          "B",
          20.0,
          "C",
          40.0
        ],
        "shape": [
          3,
          2
        ]
      }
    },
    {
      "id": "groupby_sort_order_zero_rejected",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\"}, {10;20;30}, SUM, 0, 0, 0)",
      "setup": {},
      "skipped": "sort_order 0 is outside Excel's domain for that argument (a signed column index, no zero member) and Excel returns #VALUE!. Formulon accepts it and returns the grouped spill, so a workbook that computes here errors in Excel. Isolated by varying one argument at a time: field_headers=0 and total_depth=0 are both accepted, and every form carrying sort_order=0 errors while 1 or omission spills."
    },
    {
      "id": "groupby_unknown_name_error",
      "formula": "=GROUPBY({\"A\";\"B\"}, {1;2}, NOPE_THIS_IS_NOT_A_FUNCTION, 0, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NAME?"
      }
    },
    {
      "id": "groupby_field_headers_out_of_range",
      "formula": "=GROUPBY({\"A\";\"B\"}, {1;2}, SUM, 5, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "groupby_filter_array_length_mismatch",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\"}, {1;2;3}, SUM, 0, 0, 0, {TRUE;FALSE;TRUE;TRUE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "groupby_filter_array_excludes_all",
      "formula": "=GROUPBY({\"A\";\"B\"}, {1;2}, SUM, 0, 0, 0, {FALSE;FALSE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "groupby_subtotal_depth_two",
      "formula": "=GROUPBY({\"A\",\"x\";\"A\",\"y\";\"B\",\"x\"}, {10;20;30}, SUM, 0, 2)",
      "setup": {},
      "expect": {
        "kind": "array",
        "value": [
          "A",
          "x",
          10.0,
          "A",
          "y",
          20.0,
          "A",
          null,
          30.0,
          "B",
          "x",
          30.0,
          "B",
          null,
          30.0,
          "総計",
          null,
          60.0
        ],
        "shape": [
          6,
          3
        ]
      }
    }
  ]
}
