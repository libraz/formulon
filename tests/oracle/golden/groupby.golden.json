{
  "suite": "groupby",
  "description": "GROUPBY dynamic-array group-and-aggregate (Excel 365). Six perspectives spanning bare-name aggregator dispatch (spill), LAMBDA aggregator dispatch (spill), unknown-name ->",
  "environment": {
    "excel_version": "16.109",
    "excel_locale": "ja-JP",
    "date1904": false,
    "iterative": false,
    "generated_at": "2026-05-15T01:15:06Z"
  },
  "tolerance": {
    "abs": 1e-12,
    "rel": 1e-12
  },
  "cases": [
    {
      "id": "groupby_bare_sum",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\"}, {10;20;30}, SUM, 0, 0, 0)",
      "setup": {},
      "skipped": "Mac Excel 16.109 returns #VALUE! for this compact inline-array GROUPBY/SUM formula; Formulon returns the documented grouped spill covered by unit tests."
    },
    {
      "id": "groupby_lambda_sum",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\";\"C\"}, {10;20;30;40}, LAMBDA(v, SUM(v)), 0, 0, 0)",
      "setup": {},
      "skipped": "Mac Excel 16.109 returns #VALUE! for this compact inline-array GROUPBY/LAMBDA formula; Formulon returns the documented grouped spill covered by unit tests."
    },
    {
      "id": "groupby_unknown_name_error",
      "formula": "=GROUPBY({\"A\";\"B\"}, {1;2}, NOPE_THIS_IS_NOT_A_FUNCTION, 0, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#NAME?"
      }
    },
    {
      "id": "groupby_field_headers_out_of_range",
      "formula": "=GROUPBY({\"A\";\"B\"}, {1;2}, SUM, 5, 0, 0)",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "groupby_filter_array_length_mismatch",
      "formula": "=GROUPBY({\"A\";\"B\";\"A\"}, {1;2;3}, SUM, 0, 0, 0, {TRUE;FALSE;TRUE;TRUE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    },
    {
      "id": "groupby_filter_array_excludes_all",
      "formula": "=GROUPBY({\"A\";\"B\"}, {1;2}, SUM, 0, 0, 0, {FALSE;FALSE})",
      "setup": {},
      "expect": {
        "kind": "error",
        "code": "#VALUE!"
      }
    }
  ]
}
