{
  "suite": "print_basic",
  "kind": "workbook",
  "description": "Basic print-area / page-setup oracle cases: explicit and absent print areas, A4 vs Letter paper, portrait vs landscape orientation, print titles, a multi-area print range, and hidden columns / rows that carry no recorded size. Every case carries a small populated grid on \"Sheet1\" and a print block describing the page setup.",
  "cases": [
    {
      "id": "explicit_print_area_a4_portrait",
      "description": "An explicit A1:D20 print area on A4 portrait at 100% scale.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "text",
            "value": "H"
          },
          "D20": {
            "kind": "text",
            "value": "X"
          }
        }
      },
      "print": {
        "sheet": "Sheet1",
        "print_area": "A1:D20",
        "page_setup": {
          "orientation": "portrait",
          "paper": 9,
          "scale": 100
        }
      }
    },
    {
      "id": "absent_print_area_used_range_fallback",
      "description": "No print area; the engine falls back to the used range.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "number",
            "value": 1.0
          },
          "B2": {
            "kind": "number",
            "value": 2.0
          },
          "C3": {
            "kind": "number",
            "value": 3.0
          }
        }
      },
      "print": {
        "sheet": "Sheet1",
        "page_setup": {
          "orientation": "portrait",
          "paper": 9,
          "scale": 100
        }
      }
    },
    {
      "id": "letter_portrait",
      "description": "A4-shaped grid on US Letter paper, portrait.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "text",
            "value": "H"
          },
          "F30": {
            "kind": "text",
            "value": "X"
          }
        }
      },
      "print": {
        "sheet": "Sheet1",
        "print_area": "A1:F30",
        "page_setup": {
          "orientation": "portrait",
          "paper": 1,
          "scale": 100
        }
      }
    },
    {
      "id": "a4_landscape",
      "description": "A4 landscape orientation swaps the body width and height.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "text",
            "value": "H"
          },
          "F30": {
            "kind": "text",
            "value": "X"
          }
        }
      },
      "print": {
        "sheet": "Sheet1",
        "print_area": "A1:F30",
        "page_setup": {
          "orientation": "landscape",
          "paper": 9,
          "scale": 100
        }
      }
    },
    {
      "id": "print_titles_repeat_rows",
      "description": "A print area with a repeat-rows print title.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "text",
            "value": "Header"
          },
          "A40": {
            "kind": "text",
            "value": "X"
