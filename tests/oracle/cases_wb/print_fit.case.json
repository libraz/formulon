{
  "suite": "print_fit",
  "kind": "workbook",
  "description": "Scale vs fit-to-page oracle cases: explicit reduced / enlarged scale percentages against fit-to-width / fit-to-height collapse. Every case uses the same wide-or-tall table whose breaks the scale or fit toggle changes. No golden is committed: print golden generation needs a Windows + Excel host.\n",
  "cases": [
    {
      "id": "scale_100_baseline",
      "description": "A wide table at 100% scale; vertical breaks present.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "text",
            "value": "x"
          },
          "H1": {
            "kind": "text",
            "value": "x"
          }
        }
      },
      "column_widths": {
        "A:H": 30
      },
      "print": {
        "sheet": "Sheet1",
        "print_area": "A1:H1",
        "page_setup": {
          "orientation": "portrait",
          "paper": 9,
          "scale": 100
        }
      }
    },
    {
      "id": "scale_50_shrinks_breaks",
      "description": "The same wide table at 50% scale fits more columns per page.",
