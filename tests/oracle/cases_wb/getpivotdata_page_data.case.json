{
  "suite": "getpivotdata_page_data",
  "kind": "workbook",
  "description": "Windows Excel workbook-oracle probes for GETPIVOTDATA field routing. The first case places Region on the page axis, the second addresses a value-axis field explicitly. formula_probes are evaluated only after the PivotTable is built; no golden is checked in until a product-verified Microsoft 365 Windows host is available.",
  "cases": [
    {
      "id": "page_axis_field",
      "description": "Page-axis field/item addressing plus the direct #REF branch.",
      "sheets": {
        "Data": {
          "A1": {"kind": "text", "value": "Region"},
          "B1": {"kind": "text", "value": "Product"},
          "C1": {"kind": "text", "value": "Amount"},
          "A2": {"kind": "text", "value": "North"},
          "B2": {"kind": "text", "value": "Widget"},
          "C2": {"kind": "number", "value": 100.0},
          "A3": {"kind": "text", "value": "North"},
          "B3": {"kind": "text", "value": "Gadget"},
          "C3": {"kind": "number", "value": 50.0},
          "A4": {"kind": "text", "value": "South"},
          "B4": {"kind": "text", "value": "Widget"},
          "C4": {"kind": "number", "value": 200.0},
          "A5": {"kind": "text", "value": "South"},
          "B5": {"kind": "text", "value": "Gadget"},
          "C5": {"kind": "number", "value": 300.0}
        },
        "Report": {}
      },
      "pivot": {
        "source": "Data!A1:C5",
        "anchor": "Report!A1",
        "row_fields": ["Product"],
        "page_fields": ["Region"],
        "data_fields": [{"field": "Amount", "agg": "Sum"}],
        "formula_probes": [
          {"id": "page_field_item", "cell": "Report!Z1", "formula": "=GETPIVOTDATA(\"合計 / Amount\",Report!A1,\"Region\",\"North\")"},
          {"id": "unknown_field_ref", "cell": "Report!Z2", "formula": "=GETPIVOTDATA(\"合計 / Amount\",Report!A1,\"MissingField\",\"x\")"}
        ]
      }
    },
    {
      "id": "data_axis_field",
      "description": "Value-axis field/item addressing plus the direct #REF branch.",
      "sheets": {
        "Data": {
          "A1": {"kind": "text", "value": "Region"},
          "B1": {"kind": "text", "value": "Amount"},
          "A2": {"kind": "text", "value": "North"},
          "B2": {"kind": "number", "value": 100.0},
          "A3": {"kind": "text", "value": "North"},
          "B3": {"kind": "number", "value": 200.0},
          "A4": {"kind": "text", "value": "South"},
          "B4": {"kind": "number", "value": 300.0},
          "A5": {"kind": "text", "value": "South"},
          "B5": {"kind": "number", "value": 400.0}
        },
        "Report": {}
      },
      "pivot": {
        "source": "Data!A1:B5",
        "anchor": "Report!A1",
        "row_fields": ["Region"],
        "data_fields": [{"field": "Amount", "agg": "Sum"}],
        "formula_probes": [
          {"id": "data_field_item", "cell": "Report!Z1", "formula": "=GETPIVOTDATA(\"合計 / Amount\",Report!A1,\"Amount\",100)"},
          {"id": "unknown_field_ref", "cell": "Report!Z2", "formula": "=GETPIVOTDATA(\"合計 / Amount\",Report!A1,\"MissingField\",\"x\")"}
        ]
      }
    }
  ]
}
