{
  "suite": "pivot_aggregations",
  "kind": "workbook",
  "description": "Aggregation-function coverage for the pivot oracle: COUNT, AVERAGE, MAX, MIN, PRODUCT, CountNumbers, and multi data-field pivots. Each case reuses a small sales dataset on a \"Data\" sheet and pivots onto \"Report\". No golden is committed: pivot golden generation needs a Windows + Excel host.",
  "cases": [
    {
      "id": "count_by_region",
      "description": "COUNT(Amount) grouped by Region.",
      "sheets": {
        "Data": {
          "A1": {
            "kind": "text",
            "value": "Region"
          },
          "B1": {
            "kind": "text",
            "value": "Amount"
          },
          "A2": {
            "kind": "text",
            "value": "North"
          },
          "B2": {
            "kind": "number",
            "value": 100.0
          },
          "A3": {
            "kind": "text",
            "value": "North"
          },
          "B3": {
            "kind": "number",
            "value": 50.0
          },
          "A4": {
            "kind": "text",
            "value": "South"
          },
          "B4": {
            "kind": "number",
            "value": 200.0
          },
          "A5": {
            "kind": "text",
            "value": "South"
          },
          "B5": {
            "kind": "number",
            "value": 300.0
          },
          "A6": {
            "kind": "text",
            "value": "North"
          },
          "B6": {
            "kind": "number",
            "value": 25.0
          },
          "A7": {
            "kind": "text",
            "value": "South"
          },
          "B7": {
            "kind": "number",
            "value": 75.0
          }
        },
        "Report": {}
      },
      "pivot": {
        "source": "Data!A1:B7",
        "anchor": "Report!A1",
        "row_fields": [
          "Region"
        ],
        "data_fields": [
          {
            "field": "Amount",
            "agg": "Count"
          }
        ]
      }
    },
