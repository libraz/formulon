{
  "suite": "print_matrix",
  "kind": "workbook",
  "description": "Parameter-matrix oracle cases for empirical rule discovery: each case varies a single axis (Zoom, FitToPages, data density, or print-title depth) while pinning every other axis to a baseline value. The point is to make the *effect* of each axis observable in isolation, so the Excel-actual goldens together with the spec yield the transformation rule (e.g. how Excel's VPageBreaks.Count behaves under sparse data, whether Fit overrides Zoom, how PrintTitleRows subtracts from body). No golden is committed: matrix golden generation needs a Windows + Excel host. See the Windows-side handoff (next to this file) for capture procedure and the residual failures each row targets.\n",
  "cases": [
    {
      "id": "zoom_100_dense_fit_off",
      "description": "Baseline zoom 100% on dense A1:H30 with FitToPages OFF.",
      "sheets": {
        "Sheet1": {
          "A1": {
            "kind": "text",
            "value": "x"
          },
          "A30": {
            "kind": "text",
            "value": "x"
          },
          "H1": {
            "kind": "text",
            "value": "x"
          },
          "H30": {
            "kind": "text",
            "value": "x"
          },
          "D15": {
            "kind": "text",
            "value": "x"
          }
        }
      },
      "column_widths": {
        "A:H": 30
      },
      "row_heights": {
        "1": 80,
        "30": 80
      },
      "print": {
        "sheet": "Sheet1",
        "print_area": "A1:H30",
        "page_setup": {
          "orientation": "portrait",
          "paper": 9,
          "scale": 100
        }
      }
