      "id": "cellis_greater_than_50",
      "description": "cellIs > 50 over A1:A3 = [10, 60, 90].",
      "sheet": [
        {"row": 0, "col": 0, "kind": "number", "value": 10},
        {"row": 1, "col": 0, "kind": "number", "value": 60},
        {"row": 2, "col": 0, "kind": "number", "value": 90}
      ],
      "cf_blocks": [
        {
          "sqref": [{"first_row": 0, "first_col": 0, "last_row": 2, "last_col": 0}],
          "rules": [
            {
              "type": "CellIs",
              "priority": 1,
              "operator": "GreaterThan",
              "dxf_id": 7,
              "formula1": "50"
            }
          ]
        }
      ],
      "range": {"first_row": 0, "first_col": 0, "last_row": 2, "last_col": 0}
    },
