# Python wheel staging artefacts. The wheel ships `formulon_capi.wasm`
# (built by `make wasm-capi` and copied here by `scripts/stage.py`), but
# the binary blob and its auto-generated package-init stay out of the
# source tree -- they are regenerated on every wheel build.
packages/python/formulon/_wasm/
build-py/

# Oracle generated artifacts (golden JSON is committed; intermediate workbooks are not)
tests/oracle/work/
tests/oracle/_tmp/
*.xlsx~
# A scaffolded target's capture lands in the golden directory itself, so its
# candidate marker is written there too. `make oracle-promote` consumes it and
# supersedes it with the PROVENANCE.json beside it, which is what is committed.
tests/oracle/golden_wb/PROVENANCE.candidate.json

# Fuzz corpora / crashes
tests/fuzz/corpus/
tests/fuzz/crashes/
tests/fuzz/artifacts/

# Benchmarks
bench_results/
*.nanobench.json

# Excel owner-lock files, left behind whenever a probe drives Excel over a
# fixture. Never part of a fixture, and 165 bytes of noise if committed.
~$*
