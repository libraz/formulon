{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "files": {
    "includes": [
      "packages/npm/**/*.mjs",
      "packages/npm-native/**/*.mjs",
      "packages/npm-native/**/*.d.ts",
      "tests/wasm/**/*.mjs",
      "src/wasm/**/*.d.ts",
      "!packages/npm/dist/**",
      "!packages/npm-native/dist/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useOptionalChain": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConstEnum": "off",
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**/*.mjs", "tests/wasm/**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          }
        }
      }
    }
  ]
}
